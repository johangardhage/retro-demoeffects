{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "meson compile current demo",
      "type": "shell",
      "command": "meson",
      "args": ["compile", "-C", "build", "${fileBasenameNoExtension}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run current demo",
      "type": "shell",
      "command": "meson compile -C build ${fileBasenameNoExtension} && ./build/${fileBasenameNoExtension} --window",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
