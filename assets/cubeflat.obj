#
# cubeflat.obj - Unit cube, cross atlas UVs, one normal per face
#
# Geometry:   unit cube centred on the origin, corners at ±1.
# Components: 8 vertices, 14 UV coordinates laid out as a cross atlas, so
#             every face takes its own quarter of the texture, 6 vertex
#             normals along the face axes, and 12 triangular faces,
#             listed as 6 quads split (0, 1, 2) and (0, 2, 3). The same
#             cube as cube.obj except that each face's corners carry that
#             face's own normal, so the normal is constant across a face
#             rather than swept between corner diagonals.
# Used by:    environmap.
#
o cubeflat
v 1.000000 1.000000 -1.000000
v 1.000000 1.000000 1.000000
v 1.000000 -1.000000 1.000000
v 1.000000 -1.000000 -1.000000
v -1.000000 -1.000000 -1.000000
v -1.000000 -1.000000 1.000000
v -1.000000 1.000000 1.000000
v -1.000000 1.000000 -1.000000
vt 0.750000 0.500000
vt 0.750000 0.250000
vt 0.500000 0.250000
vt 0.500000 0.500000
vt 0.250000 0.500000
vt 0.250000 0.250000
vt 0.000000 0.250000
vt 0.000000 0.500000
vt 0.500000 1.000000
vt 0.500000 0.750000
vt 0.250000 0.750000
vt 0.250000 1.000000
vt 0.500000 0.000000
vt 0.250000 0.000000
vn 1.0000 0.0000 0.0000
vn -1.0000 0.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn 0.0000 0.0000 1.0000
vn 0.0000 0.0000 -1.0000
s off
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 5/5/2 6/6/2 7/7/2
f 5/5/2 7/7/2 8/8/2
f 2/9/3 1/10/3 8/11/3
f 2/9/3 8/11/3 7/12/3
f 4/4/4 3/3/4 6/6/4
f 4/4/4 6/6/4 5/5/4
f 3/3/5 2/13/5 7/14/5
f 3/3/5 7/14/5 6/6/5
f 1/10/6 4/4/6 5/5/6
f 1/10/6 5/5/6 8/11/6
