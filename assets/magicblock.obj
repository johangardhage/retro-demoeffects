#
# magicblock.obj - Magic block slab
#
# Geometry:   a square slab 4 across and 0.5 thick, centred on the
#             origin, its broad faces at z = ±0.25.
# Components: 8 vertices and 6 quad faces, no UV coordinates or normals.
#             The two broad faces come first, -z then +z, then the four
#             edges. All are wound outward.
# Used by:    magicblock.
#
o magicblock
v 2.000000 2.000000 -0.250000
v 2.000000 -2.000000 -0.250000
v -2.000000 -2.000000 -0.250000
v -2.000000 2.000000 -0.250000
v 2.000000 2.000000 0.250000
v 2.000000 -2.000000 0.250000
v -2.000000 -2.000000 0.250000
v -2.000000 2.000000 0.250000
f 1/1/1 2/1/1 3/1/1 4/1/1
f 8/1/1 7/1/1 6/1/1 5/1/1
f 1/1/1 5/1/1 6/1/1 2/1/1
f 2/1/1 6/1/1 7/1/1 3/1/1
f 3/1/1 7/1/1 8/1/1 4/1/1
f 4/1/1 8/1/1 5/1/1 1/1/1
