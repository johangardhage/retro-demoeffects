#
# shadow_cube.obj - Cube
#
# Geometry:   unit cube centred on the origin, corners at ±1.
# Components: 8 vertices, 8 UV coordinates, each face taking the whole
#             texture, 6 normals, one per face, so each side is lit flat,
#             and 12 triangular faces.
# Used by:    shadow through shadow4, textured with sandstone and lit, and
#             every shadow demo and robots, in a flat colour, to mark each
#             point light.
#
o shadow_cube
v 1.000000 -1.000000 1.000000
